# Demo mode works without any environment variables.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional product analytics. Leave blank to disable tracking.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Supabase (optional, for persisted auth and user data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (optional, server-side only)
AI_PROVIDER=demo
OPENAI_API_KEY=

# Official marketplace adapter (optional, no scraping)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# NBA roster source (server-side only; never expose in NEXT_PUBLIC_*).
# nba_official uses the dated NBA.com public roster snapshot and needs no key.
# Set sportradar only after configuring its licensed API key.
NBA_ROSTER_PROVIDER=nba_official
SPORTRADAR_API_KEY=
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_LANGUAGE=zh
ROSTER_SYNC_TOKEN=
