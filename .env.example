# Demo mode works without any environment variables.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional, for persisted auth and user data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (optional, server-side only)
AI_PROVIDER=demo
OPENAI_API_KEY=

# Official marketplace adapter (optional, no scraping)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
